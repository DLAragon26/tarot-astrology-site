{
  "name": "tarot-astrology-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "worker",
    "shared"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspace @tarot/shared && npm run typecheck --workspace @tarot/worker && npm run typecheck --workspace @tarot/web",
    "astrocheck": "npm run check --workspace @tarot/web",
    "secret-scan": "node scripts/secret-scan.mjs",
    "check": "npm run typecheck && npm run astrocheck && npm run secret-scan",
    "test": "vitest run",
    "build": "npm run build --workspace @tarot/web",
    "dev:web": "npm run dev --workspace @tarot/web",
    "dev:worker": "npm run dev --workspace @tarot/worker",
    "db:migrate:local": "npm run db:migrate:local --workspace @tarot/worker",
    "db:migrate:remote": "npm run db:migrate:remote --workspace @tarot/worker",
    "deploy": "npm run deploy --workspace @tarot/worker",
    "assets:gen": "node scripts/gen-placeholders.mjs && node scripts/gen-zodiac-svgs.mjs",
    "cards:assets": "node scripts/gen-card-assets.mjs",
    "cards:assets:check": "node scripts/gen-card-assets.mjs --check",
    "check:base": "node scripts/check-base-links.mjs",
    "build:pages": "PUBLIC_BASE_PATH=/tarot-astrology-site SITE_URL=https://USERNAME.github.io PUBLIC_API_BASE_URL=${PUBLIC_API_BASE_URL:-http://localhost:8787} npm run build --workspace @tarot/web",
    "cards:download": "node scripts/download-cards.mjs",
    "cards:verify": "node scripts/download-cards.mjs --verify",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  }
}
