---
import Base from '../layouts/Base.astro';
---

<Base title="管理 · 塔罗与星座" active="admin">
  <h1>管理</h1>
  <p class="muted">仅管理员可用。成员访问本页的接口会被后端拒绝（403）。</p>
  <div id="denied" class="notice error" hidden>你不是管理员。</div>

  <div id="content" hidden>
    <h2>全站概况</h2>
    <div id="overview" class="muted">加载中…</div>

    <h2>创建用户</h2>
    <div class="panel">
      <div style="display:flex; gap:12px; flex-wrap:wrap;">
        <div style="flex:1; min-width:140px;"><label class="field" for="nu-username">用户名</label><input type="text" id="nu-username" /></div>
        <div style="flex:1; min-width:140px;"><label class="field" for="nu-password">初始密码（至少 8 位）</label><input type="password" id="nu-password" autocomplete="new-password" /></div>
        <div style="flex:1; min-width:120px;">
          <label class="field" for="nu-role">角色</label>
          <select id="nu-role"><option value="member">成员</option><option value="admin">管理员</option></select>
        </div>
        <div style="flex:1; min-width:120px;"><label class="field" for="nu-limit">每日 AI 额度（默认 0，不分配则不可用）</label><input type="text" id="nu-limit" value="0" placeholder="0" /></div>
      </div>
      <button class="btn" id="nu-submit" type="button">创建用户</button>
      <div id="nu-msg" class="notice" hidden></div>
    </div>

    <h2>邀请码</h2>
    <div class="panel">
      <button class="btn accent" id="invite-btn" type="button">生成一次性邀请码</button>
      <div id="invite-new" class="notice" hidden></div>
      <div id="invite-list"></div>
    </div>

    <h2>用户管理</h2>
    <div id="user-msg" class="notice" hidden></div>
    <div id="user-table"></div>
  </div>

  <dialog id="admin-dialog" class="admin-dialog">
    <form id="admin-dialog-form">
      <h2 id="admin-dialog-title"></h2>
      <p id="admin-dialog-description" class="muted"></p>
      <label class="field" for="admin-dialog-input" id="admin-dialog-label"></label>
      <input id="admin-dialog-input" />
      <label class="checkbox-row" id="admin-dialog-reveal-wrap">
        <input type="checkbox" id="admin-dialog-reveal" />
        显示输入内容
      </label>
      <div class="dialog-actions">
        <button class="btn secondary" id="admin-dialog-cancel" type="button">取消</button>
        <button class="btn" id="admin-dialog-confirm" type="submit">确认</button>
      </div>
    </form>
  </dialog>
</Base>

<script>
  import '../scripts/admin';
</script>
