---
import Base from '../layouts/Base.astro';
---

<Base title="历史记录 · 塔罗与星座" active="history">
  <h1>历史记录</h1>
  <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:12px;">
    <div style="flex:1; min-width:140px;" id="scope-wrap" hidden>
      <label class="field" for="filter-scope">记录范围</label>
      <select id="filter-scope">
        <option value="self">我的记录</option>
        <option value="all">全站记录</option>
      </select>
    </div>
    <div style="flex:1; min-width:140px;" id="user-wrap" hidden>
      <label class="field" for="filter-user">用户</label>
      <select id="filter-user"><option value="">全部用户</option></select>
    </div>
    <div style="flex:1; min-width:140px;">
      <label class="field" for="filter-mode">模式</label>
      <select id="filter-mode">
        <option value="">全部</option>
        <option value="online">线上抽牌</option>
        <option value="offline">线下录入</option>
      </select>
    </div>
    <div style="flex:1; min-width:140px;">
      <label class="field" for="filter-topic">主题</label>
      <select id="filter-topic"><option value="">全部</option></select>
    </div>
  </div>
  <div class="toolbar-row" style="margin-top:16px;">
    <input type="search" id="search-input" placeholder="搜索问题 / 备注 / 解读关键词…" style="flex:1;" />
    <button class="btn secondary" id="export-json" type="button">导出 JSON</button>
    <button class="btn secondary" id="export-md" type="button">导出 Markdown</button>
  </div>
  <div id="list"></div>
  <div id="empty" class="muted" hidden style="margin-top:32px;">还没有记录。</div>
  <button class="btn secondary" id="more-btn" hidden type="button">加载更多</button>
  <div id="err" class="notice error" hidden></div>

  <dialog id="detail-dialog" class="detail-dialog">
    <div id="detail-body"></div>
    <div class="dialog-actions">
      <button class="btn secondary" id="detail-close" type="button">关闭</button>
    </div>
  </dialog>
</Base>

<script>
  import '../scripts/history';
</script>
