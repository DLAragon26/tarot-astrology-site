---
import Base from '../layouts/Base.astro';
---

<Base title="线下录入 · 塔罗与星座" active="offline">
  <div id="quota-line" class="muted"></div>
  <h1>线下排面录入</h1>
  <p class="muted">把实际抽出的牌面记录下来，用于归档与 AI 解读。</p>

  <label class="field" for="question">当时的问题</label>
  <textarea id="question" maxlength="500" placeholder="记录你当时问的问题"></textarea>

  <div style="display:flex; gap:12px; flex-wrap:wrap;">
    <div style="flex:1; min-width:140px;">
      <label class="field" for="topic">主题标签（可选）</label>
      <select id="topic"></select>
    </div>
    <div style="flex:1; min-width:140px;">
      <label class="field" for="mood">心情标签（可选）</label>
      <select id="mood"></select>
    </div>
  </div>
  <label class="checkbox-row" style="margin-top:10px;">
    <input type="checkbox" id="context-consent" />
    <span>让 AI 参考我最近记录的主题（默认关闭；仅向 AI 传入最近 5 条记录的问题与主题标签）</span>
  </label>
  <div id="draft-notice" class="notice" hidden></div>
  <div id="restore-box" class="notice" hidden>
    <p id="restore-text" style="margin:0 0 8px;"></p>
    <button class="btn secondary" id="restore-btn" type="button">恢复上次草稿</button>
    <button class="btn secondary" id="discard-btn" type="button">丢弃</button>
  </div>

  <h2>选择牌阵</h2>
  <div id="spread-picker"></div>

  <div id="cards-form" hidden>
    <label class="field" for="card-search">搜索牌名（中英文）</label>
    <input type="search" id="card-search" placeholder="如：愚者 / Moon / 星币八" />
    <div id="position-list"></div>
    <button class="btn accent" id="confirm-btn" type="button">确认牌面</button>
  </div>

  <div id="spread-area"></div>

  <div id="result-area" hidden>
    <button class="btn" id="interpret-btn" type="button">请求 AI 解读</button>
    <p class="muted">点击解读会将问题、标签和牌面发送给本站配置的 AI 服务。</p>
    <div id="interpret-err" class="notice error" hidden></div>
    <div id="interpret-out" hidden>
      <div class="panel"><div id="interpret-text"></div></div>
      <p class="muted">解读基于心理反思与象征视角，不构成对未来的断言；医疗、投资、法律决定请咨询专业人士。</p>
    </div>
    <button class="btn secondary" id="save-btn" type="button">保存记录</button>
    <div id="save-msg" class="notice" hidden></div>
  </div>
</Base>

<script>
  import '../scripts/offline';
</script>
