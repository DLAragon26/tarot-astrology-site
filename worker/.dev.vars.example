# 复制为 .dev.vars 并填入本地开发值；.dev.vars 已被 .gitignore 排除，绝不提交。
# 所有值均为占位符示例，真实值只在本地 .dev.vars 或 Cloudflare Secrets 中。

# AI（OpenAI-compatible；示例默认 DeepSeek，可换成任何兼容服务）
API_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
API_KEY=placeholder-put-your-real-key-in-dev-vars-only
MAX_TOKENS=900
TEMPERATURE=0.8

# 站点访问密钥（登录三要素之一）
SITE_ACCESS_KEY=placeholder-site-access-key

# 会话签名密钥（随机长字符串）
SESSION_SECRET=placeholder-session-secret-random-long-string

# 首次引导：users 表为空时，用 admin + 此密码可创建管理员，登录后必须改密
ADMIN_INITIAL_PASSWORD=placeholder-admin-initial-password

# 全站每日 AI 上限（可被 settings 表覆盖）
GLOBAL_DAILY_AI_LIMIT=200

# CORS 白名单（逗号分隔）
ALLOWED_ORIGINS=http://localhost:4321

# 仅本地 http 调试可设 false；生产必须 true
COOKIE_SECURE=false
